		clock-names = "spiclk", "apb_pclk";
		clocks = <&{/clock-controller@ff2b0000} 0x24 &{/clock-controller@ff2b0000} 0x155>;
		compatible = "rockchip,px30-spi", "rockchip,rk3066-spi";
		dma-names = "tx", "rx";
		dmas = <&{/bus/dmac@ff240000} 0xc &{/bus/dmac@ff240000} 0xd>;
		interrupts = <0x0 0x1a 0x4>;
		pinctrl-0 = <&{/pinctrl/spi0/spi0-clk}  &{/pinctrl/spi0/spi0-csn}  &{/pinctrl/spi0/spi0-miso}  &{/pinctrl/spi0/spi0-mosi} >;
		pinctrl-1 = <&{/pinctrl/spi0/spi0-clk-hs}  &{/pinctrl/spi0/spi0-csn}  &{/pinctrl/spi0/spi0-miso-hs}  &{/pinctrl/spi0/spi0-mosi-hs} >;
		pinctrl-names = "default", "high_speed";
		reg = <0x0 0xff1d0000 0x0 0x1000>;
		status = "disabled";
	};
	spi@ff1d8000 {
		#address-cells = <0x1>;
		#size-cells = <0x0>;
		clock-names = "spiclk", "apb_pclk";
		clocks = <&{/clock-controller@ff2b0000} 0x25 &{/clock-controller@ff2b0000} 0x156>;
		compatible = "rockchip,px30-spi", "rockchip,rk3066-spi";
		dma-names = "tx", "rx";
		dmas = <&{/bus/dmac@ff240000} 0xe &{/bus/dmac@ff240000} 0xf>;
		interrupts = <0x0 0x1b 0x4>;
		pinctrl-0 = <&{/pinctrl/spi1/spi1-clk}  &{/pinctrl/spi1/spi1-csn0}  &{/pinctrl/spi1/spi1-csn1}  &{/pinctrl/spi1/spi1-miso}  &{/pinctrl/spi1/spi1-mosi} >;
		pinctrl-1 = <&{/pinctrl/spi1/spi1-clk-hs}  &{/pinctrl/spi1/spi1-csn0}  &{/pinctrl/spi1/spi1-csn1}  &{/pinctrl/spi1/spi1-miso-hs}  &{/pinctrl/spi1/spi1-mosi-hs} >;
		pinctrl-names = "default", "high_speed";
		reg = <0x0 0xff1d8000 0x0 0x1000>;
		status = "disabled";
	};
	spi@ff3a0000 {
		assigned-clock-rates = <0x989680>;
		assigned-clocks = <&{/clock-controller@ff2b0000} 0x3a>;
		clock-names = "clk_sfc", "hclk_sfc";
		clocks = <&{/clock-controller@ff2b0000} 0x3a &{/clock-controller@ff2b0000} 0x101>;
		compatible = "rockchip,sfc";
		interrupts = <0x0 0x38 0x4>;
		reg = <0x0 0xff3a0000 0x0 0x4000>;
		status = "disabled";
	};
	syscon@ff010000 {
		#address-cells = <0x1>;
		#size-cells = <0x1>;
		compatible = "rockchip,px30-pmugrf", "syscon", "simple-mfd";
		reg = <0x0 0xff010000 0x0 0x1000>;
		io-domains {
			compatible = "rockchip,px30-pmu-io-voltage-domain";
			pmuio1-supply = <&{/i2c@ff180000/pmic@20/regulators/LDO_REG4} >;
			pmuio2-supply = <&{/i2c@ff180000/pmic@20/regulators/LDO_REG4} >;
			status = "okay";
		};
		pmu-pvtm {
			clock-names = "pmu";
			clocks = <&{/clock-controller@ff2bc000} 0x7>;
			compatible = "rockchip,px30-pmu-pvtm";
			status = "okay";
		};
		reboot-mode {
			compatible = "syscon-reboot-mode";
			mode-bootloader = <0x5242c301>;
			mode-charge = <0x5242c30b>;
			mode-fastboot = <0x5242c309>;
			mode-loader = <0x5242c301>;
			mode-normal = <0x5242c300>;
			mode-recovery = <0x5242c303>;
			mode-ums = <0x5242c30c>;
			offset = <0x200>;
		};
	};
	syscon@ff140000 {
		#address-cells = <0x1>;
		#size-cells = <0x1>;
		compatible = "rockchip,px30-grf", "syscon", "simple-mfd";
		reg = <0x0 0xff140000 0x0 0x1000>;
		io-domains {
			compatible = "rockchip,px30-io-voltage-domain";
			status = "okay";
			vccio1-supply = <&{/i2c@ff180000/pmic@20/regulators/LDO_REG5} >;
			vccio2-supply = <&{/i2c@ff180000/pmic@20/regulators/LDO_REG5} >;
			vccio3-supply = <&{/i2c@ff180000/pmic@20/regulators/DCDC_REG4} >;
			vccio4-supply = <&{/i2c@ff180000/pmic@20/regulators/DCDC_REG4} >;
			vccio5-supply = <&{/i2c@ff180000/pmic@20/regulators/DCDC_REG4} >;
			vccio6-supply = <&{/i2c@ff180000/pmic@20/regulators/DCDC_REG4} >;
		};
		lvds {
			compatible = "rockchip,px30-lvds";
			phy-names = "phy";
			phys = <&{/phy@ff2e0000} >;
			status = "disabled";
			ports {
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				port@0 {
					#address-cells = <0x1>;
					#size-cells = <0x0>;
					reg = <0x0>;
					endpoint@0 {
						reg = <0x0>;
						remote-endpoint = <&{/vop@ff460000/port/endpoint@0} >;
					};
				};
			};
		};
		rgb {
			compatible = "rockchip,px30-rgb";
			phy-names = "phy";
			phys = <&{/phy@ff2e0000} >;
			pinctrl-0 = <&{/pinctrl/lcdc/lcdc-m1-rgb-pins} >;
			pinctrl-1 = <&{/pinctrl/lcdc/lcdc-m1-sleep-pins} >;
			pinctrl-names = "default", "sleep";
			status = "disabled";
			ports {
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				port@0 {
					#address-cells = <0x1>;
					#size-cells = <0x0>;
					reg = <0x0>;
					endpoint@0 {
						reg = <0x0>;
						remote-endpoint = <&{/vop@ff460000/port/endpoint@2} >;
					};
				};
			};
		};
	};
	syscon@ff148000 {
		#address-cells = <0x1>;
		#size-cells = <0x1>;
		compatible = "syscon", "simple-mfd";
		reg = <0x0 0xff148000 0x0 0x1000>;
		pvtm {
			clock-names = "core";
			clocks = <&{/clock-controller@ff2b0000} 0x4a>;
			compatible = "rockchip,px30-pvtm";
			status = "okay";
		};
	};
	syscon@ff2c0000 {
		#address-cells = <0x1>;
		#size-cells = <0x1>;
		compatible = "rockchip,px30-usb2phy-grf", "syscon", "simple-mfd";
		reg = <0x0 0xff2c0000 0x0 0x10000>;
		usb2-phy@100 {
			#clock-cells = <0x0>;
			assigned-clock-parents = <&{/syscon@ff2c0000/usb2-phy@100}  &{/clock-controller@ff2b0000} 0xe>;
			assigned-clocks = <&{/clock-controller@ff2b0000} 0xe &{/clock-controller@ff2b0000} 0x55>;
			clock-names = "phyclk";
			clock-output-names = "usb480m_phy";
			clocks = <&{/clock-controller@ff2bc000} 0xa>;
			compatible = "rockchip,px30-usb2phy", "rockchip,rk3328-usb2phy";
			reg = <0x100 0x10>;
			status = "okay";
			host-port {
				#phy-cells = <0x0>;
				interrupt-names = "linestate";
				interrupts = <0x0 0x44 0x4>;
				status = "okay";
			};
			otg-port {
				#phy-cells = <0x0>;
				interrupt-names = "otg-bvalid", "otg-id", "linestate";
				interrupts = <0x0 0x42 0x4 0x0 0x41 0x4 0x0 0x40 0x4>;
				status = "disabled";
			};
		};
	};
	thermal-zones {
		gpu-thermal {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x64>;
			thermal-sensors = <&{/tsadc@ff280000} 0x1>;
		};
		soc-thermal {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x14>;
			sustainable-power = <0x2ee>;
			thermal-sensors = <&{/tsadc@ff280000} 0x0>;
			cooling-maps {
				map0 {
					contribution = <0x1000>;
					cooling-device = <&{/cpus/cpu@0} 0xffffffff 0xffffffff>;
					trip = <&{/thermal-zones/soc-thermal/trips/trip-point-1} >;
				};
				map1 {
					contribution = <0x1000>;
					cooling-device = <&{/gpu@ff400000} 0xffffffff 0xffffffff>;
					trip = <&{/thermal-zones/soc-thermal/trips/trip-point-1} >;
				};
			};
			trips {
				soc-crit {
					hysteresis = <0x7d0>;
					temperature = <0x1c138>;
					type = "critical";
				};
				trip-point-0 {
					hysteresis = <0x7d0>;
					temperature = <0x11170>;
					type = "passive";
				};
				trip-point-1 {
					hysteresis = <0x7d0>;
					temperature = <0x14c08>;
					type = "passive";
				};
			};
		};
	};
	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x1 0xd 0xf04 0x1 0xe 0xf04 0x1 0xb 0xf04 0x1 0xa 0xf04>;
	};
	timer@ff210000 {
		clock-names = "pclk", "timer";
		clocks = <&{/clock-controller@ff2b0000} 0x159 &{/clock-controller@ff2b0000} 0x26>;
		compatible = "rockchip,rk3288-timer";
		interrupts = <0x0 0x1e 0x4>;
		reg = <0x0 0xff210000 0x0 0x1000>;
	};
	tsadc@ff280000 {
		#thermal-sensor-cells = <0x1>;
		assigned-clock-rates = <0xc350>;
		assigned-clocks = <&{/clock-controller@ff2b0000} 0x2c>;
		clock-names = "tsadc", "apb_pclk";
		clocks = <&{/clock-controller@ff2b0000} 0x2c &{/clock-controller@ff2b0000} 0x158>;
		compatible = "rockchip,px30-tsadc";
		interrupts = <0x0 0x24 0x4>;
		pinctrl-0 = <&{/pinctrl/tsadc/tsadc-otp-pin} >;
		pinctrl-1 = <&{/pinctrl/tsadc/tsadc-otp-out} >;
		pinctrl-names = "gpio", "otpout";
		reg = <0x0 0xff280000 0x0 0x100>;
		reset-names = "tsadc-apb";
		resets = <&{/clock-controller@ff2b0000} 0xa8>;
		rockchip,grf = <&{/syscon@ff140000} >;
		rockchip,hw-tshut-temp = <0x1d4c0>;
		status = "okay";
	};
	usb@ff300000 {
		clock-names = "otg";
		clocks = <&{/clock-controller@ff2b0000} 0x102>;
		compatible = "rockchip,px30-usb", "rockchip,rk3066-usb", "snps,dwc2";
		dr_mode = "otg";
		g-np-tx-fifo-size = <0x10>;
		g-rx-fifo-size = <0x118>;
		g-tx-fifo-size = <0x100 0x80 0x80 0x40 0x20 0x10>;
		g-use-dma;
		interrupts = <0x0 0x3e 0x4>;
		phy-names = "usb2-phy";
		phys = <&{/syscon@ff2c0000/usb2-phy@100/otg-port} >;
		power-domains = <&{/power-management@ff000000/power-controller} 0x5>;
		reg = <0x0 0xff300000 0x0 0x40000>;
		status = "okay";
	};
	usb@ff340000 {
		clock-names = "usbhost", "utmi";
		clocks = <&{/clock-controller@ff2b0000} 0x103 &{/syscon@ff2c0000/usb2-phy@100} >;
		compatible = "generic-ehci";
		interrupts = <0x0 0x3c 0x4>;
		phy-names = "usb";
		phys = <&{/syscon@ff2c0000/usb2-phy@100/host-port} >;
		power-domains = <&{/power-management@ff000000/power-controller} 0x5>;
		reg = <0x0 0xff340000 0x0 0x10000>;
		status = "disabled";
	};
	usb@ff350000 {
		clock-names = "usbhost", "utmi";
		clocks = <&{/clock-controller@ff2b0000} 0x103 &{/syscon@ff2c0000/usb2-phy@100} >;
		compatible = "generic-ohci";
		interrupts = <0x0 0x3d 0x4>;
		phy-names = "usb";
		phys = <&{/syscon@ff2c0000/usb2-phy@100/host-port} >;
		power-domains = <&{/power-management@ff000000/power-controller} 0x5>;
		reg = <0x0 0xff350000 0x0 0x10000>;
		status = "disabled";
	};
	vccsys {
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-boot-on;
		regulator-max-microvolt = <0x39fbc0>;
		regulator-min-microvolt = <0x39fbc0>;
		regulator-name = "vcc3v8_sys";
	};
	vop@ff460000 {
		clock-names = "aclk_vop", "dclk_vop", "hclk_vop";
		clocks = <&{/clock-controller@ff2b0000} 0xb5 &{/clock-controller@ff2b0000} 0x96 &{/clock-controller@ff2b0000} 0xfb>;
		compatible = "rockchip,px30-vop-big";
		interrupts = <0x0 0x4d 0x4>;
		iommus = <&{/iommu@ff460f00} >;
		power-domains = <&{/power-management@ff000000/power-controller} 0xc>;
		reg = <0x0 0xff460000 0x0 0x1fc 0x0 0xff460a00 0x0 0x400>;
		reg-names = "regs", "gamma_lut";
		rockchip,grf = <&{/syscon@ff140000} >;
		status = "okay";
		port {
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			endpoint@0 {
				reg = <0x0>;
				remote-endpoint = <&{/syscon@ff140000/lvds/ports/port@0/endpoint@0} >;
			};
			endpoint@1 {
				reg = <0x1>;
				remote-endpoint = <&{/dsi@ff450000/ports/port@0/endpoint@0} >;
			};
			endpoint@2 {
				reg = <0x2>;
				remote-endpoint = <&{/syscon@ff140000/rgb/ports/port@0/endpoint@0} >;
			};
		};
	};
	vpu_combo {
		clock-names = "aclk_vcodec", "hclk_vcodec", "clk_core";
		clocks = <&{/clock-controller@ff2b0000} 0xaf &{/clock-controller@ff2b0000} 0xf4 &{/clock-controller@ff2b0000} 0x4b>;
		compatible = "rockchip,vpu_combo";
		mode_bit = <0xf>;
		mode_ctrl = <0x410>;
		power-domains = <&{/power-management@ff000000/power-controller} 0xb>;
		reset-names = "video_a", "video_h", "niu_a", "niu_h", "video_core";
		resets = <&{/clock-controller@ff2b0000} 0x24 &{/clock-controller@ff2b0000} 0x26 &{/clock-controller@ff2b0000} 0x25 &{/clock-controller@ff2b0000} 0x27 &{/clock-controller@ff2b0000} 0x3f>;
		rockchip,grf = <&{/syscon@ff140000} >;
		rockchip,sub = <&{/vpu_service@ff442000}  &{/hevc@ff440000} >;
		status = "okay";
		subcnt = <0x2>;
	};
	vpu_service@ff442000 {
		allocator = <0x1>;
		compatible = "rockchip,vpu_sub";
		dev_mode = <0x0>;
		interrupt-names = "irq_enc", "irq_dec";
		interrupts = <0x0 0x50 0x4 0x0 0x4f 0x4>;
		iommu_enabled = <0x1>;
		iommus = <&{/iommu@ff442800} >;
		reg = <0x0 0xff442000 0x0 0x800>;
	};
	watchdog@ff1e0000 {
		clocks = <&{/clock-controller@ff2b0000} 0x15b>;
		compatible = "snps,dw-wdt";
		interrupts = <0x0 0x25 0x4>;
		reg = <0x0 0xff1e0000 0x0 0x100>;
		reset-names = "reset";
		resets = <&{/clock-controller@ff2b0000} 0xb5>;
		status = "disabled";
	};
	xin24m {
		#clock-cells = <0x0>;
		clock-frequency = <0x16e3600>;
		clock-output-names = "xin24m";
		compatible = "fixed-clock";
	};
	xin32k {
		#clock-cells = <0x0>;
		clock-frequency = <0x8000>;
		clock-output-names = "xin32k";
		compatible = "fixed-clock";
	};
};
