					pins = "gpio_slp";
				};
				rk817_slppin_slp {
					function = "pin_fun1";
					pins = "gpio_slp";
				};
				rk817_ts_gpio1 {
					function = "pin_fun1";
					pins = "gpio_ts";
				};
