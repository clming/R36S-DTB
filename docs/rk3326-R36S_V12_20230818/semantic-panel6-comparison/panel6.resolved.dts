		power-domains = <&{/power-management@ff000000/power-controller} 0xa>;
		reg = <0x0 0xff380000 0x0 0x4000>;
		sd-uhs-sdr104;
		sd-uhs-sdr12;
		sd-uhs-sdr25;
		sd-uhs-sdr50;
		status = "okay";
		supports-sd;
		vmmc-supply = <&{/i2c@ff180000/pmic@20/regulators/LDO_REG6} >;
		vqmmc-supply = <&{/i2c@ff180000/pmic@20/regulators/LDO_REG5} >;
	};
	dwmmc@ff390000 {
		assigned-clock-parents = <&{/clock-controller@ff2b0000} 0x53>;
		assigned-clocks = <&{/clock-controller@ff2b0000} 0x39>;
		clock-names = "biu", "ciu", "ciu-drv", "ciu-sample";
		clocks = <&{/clock-controller@ff2b0000} 0x100 &{/clock-controller@ff2b0000} 0x39 &{/clock-controller@ff2b0000} 0x47 &{/clock-controller@ff2b0000} 0x48>;
		compatible = "rockchip,px30-dw-mshc", "rockchip,rk3288-dw-mshc";
		fifo-depth = <0x100>;
		interrupts = <0x0 0x35 0x4>;
		max-frequency = <0x8f0d180>;
		power-domains = <&{/power-management@ff000000/power-controller} 0xa>;
		reg = <0x0 0xff390000 0x0 0x4000>;
		status = "okay";
	};
	ethernet@ff360000 {
		clock-names = "stmmaceth", "mac_clk_rx", "mac_clk_tx", "clk_mac_ref", "clk_mac_refout", "aclk_mac", "pclk_mac", "clk_mac_speed";
		clocks = <&{/clock-controller@ff2b0000} 0x3e &{/clock-controller@ff2b0000} 0x3f &{/clock-controller@ff2b0000} 0x3f &{/clock-controller@ff2b0000} 0x40 &{/clock-controller@ff2b0000} 0x41 &{/clock-controller@ff2b0000} 0xb2 &{/clock-controller@ff2b0000} 0x143 &{/clock-controller@ff2b0000} 0x4c>;
		compatible = "rockchip,px30-gmac";
		interrupt-names = "macirq";
		interrupts = <0x0 0x2b 0x4>;
		phy-mode = "rmii";
		pinctrl-0 = <&{/pinctrl/gmac/rmii-pins}  &{/pinctrl/gmac/mac-refclk-12ma} >;
		pinctrl-names = "default";
		power-domains = <&{/power-management@ff000000/power-controller} 0x9>;
		reg = <0x0 0xff360000 0x0 0x10000>;
		reset-names = "stmmaceth";
		resets = <&{/clock-controller@ff2b0000} 0x5e>;
		rockchip,grf = <&{/syscon@ff140000} >;
		status = "disabled";
	};
	external-gmac-clock {
		#clock-cells = <0x0>;
		clock-frequency = <0x2faf080>;
		clock-output-names = "gmac_clkin";
		compatible = "fixed-clock";
