	odroidgo3-joypad {
		abs_rx-n-tuning = <0xc8>;
		abs_rx-p-tuning = <0xc8>;
		abs_ry-n-tuning = <0xc8>;
		abs_ry-p-tuning = <0xc8>;
		abs_x-n-tuning = <0xc8>;
		abs_x-p-tuning = <0xc8>;
		abs_y-n-tuning = <0xc8>;
		abs_y-p-tuning = <0xc8>;
		amux-a-gpios = <&{/pinctrl/gpio0@ff040000} 0xd 0x1>;
		amux-b-gpios = <&{/pinctrl/gpio0@ff040000} 0xc 0x1>;
		amux-count = <0x4>;
		amux-en-gpios = <&{/pinctrl/gpio0@ff040000} 0x11 0x1>;
