				clocks = <&{/clock-controller@ff2b0000} 0xb7 &{/clock-controller@ff2b0000} 0xb5 &{/clock-controller@ff2b0000} 0xb6 &{/clock-controller@ff2b0000} 0x96 &{/clock-controller@ff2b0000} 0x97 &{/clock-controller@ff2b0000} 0xfd &{/clock-controller@ff2b0000} 0xfb &{/clock-controller@ff2b0000} 0xfc &{/clock-controller@ff2b0000} 0x144 &{/clock-controller@ff2b0000} 0x35 &{/clock-controller@ff2b0000} 0x36>;
				pm_qos = <&{/qos@ff550000}  &{/qos@ff550080}  &{/qos@ff550100}  &{/qos@ff550180} >;
