				reg = <0xe>;
			};
			power-domain@5 {
				clocks = <&{/clock-controller@ff2b0000} 0x103 &{/clock-controller@ff2b0000} 0x102 &{/clock-controller@ff2b0000} 0x3c>;
				pm_qos = <&{/qos@ff540000}  &{/qos@ff540080} >;
				reg = <0x5>;
