			vcc2-supply = <&{/vccsys} >;
			vcc3-supply = <&{/vccsys} >;
			vcc4-supply = <&{/vccsys} >;
			vcc5-supply = <&{/vccsys} >;
			vcc6-supply = <&{/vccsys} >;
			vcc7-supply = <&{/vccsys} >;
			vcc8-supply = <&{/vccsys} >;
