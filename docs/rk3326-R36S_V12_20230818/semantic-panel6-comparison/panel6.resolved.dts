			power-domain@13 {
				clocks = <&{/clock-controller@ff2b0000} 0xb3 &{/clock-controller@ff2b0000} 0xb4 &{/clock-controller@ff2b0000} 0xf9 &{/clock-controller@ff2b0000} 0xfa &{/clock-controller@ff2b0000} 0x33>;
