/dts-v1/;

/ {
	#address-cells = <0x2>;
	#size-cells = <0x2>;
	compatible = "rockchip,rk3326-evb-lp3-v12-linux", "rockchip,rk3326";
	interrupt-parent = <&{/interrupt-controller@ff131000} >;
	model = "Rockchip rk3326 evb lpddr3 v12 board for linux";
	adc-keys {
		autorepeat;
		compatible = "adc-keys";
		io-channel-names = "buttons";
		io-channels = <&{/saradc@ff288000} 0x2>;
		keyup-threshold-microvolt = <0x1b7740>;
		poll-interval = <0x64>;
		vol-down-key {
			label = "volume down";
			linux,code = <0x72>;
			press-threshold-microvolt = <0x48058>;
		};
		vol-up-key {
			label = "volume up";
			linux,code = <0x73>;
			press-threshold-microvolt = <0x3a98>;
		};
	};
	aliases {
		ethernet0 = "/ethernet@ff360000";
		i2c0 = "/i2c@ff180000";
		i2c1 = "/i2c@ff190000";
		i2c2 = "/i2c@ff1a0000";
		i2c3 = "/i2c@ff1b0000";
		mmc0 = "/dwmmc@ff390000";
		mmc1 = "/dwmmc@ff370000";
		mmc2 = "/dwmmc@ff380000";
		serial0 = "/serial@ff030000";
		serial1 = "/serial@ff158000";
		serial2 = "/serial@ff160000";
		serial3 = "/serial@ff168000";
		serial4 = "/serial@ff170000";
		serial5 = "/serial@ff178000";
		spi0 = "/spi@ff1d0000";
		spi1 = "/spi@ff1d8000";
		spi2 = "/spi@ff3a0000";
	};
	arm-pmu {
		compatible = "arm,cortex-a35-pmu";
		interrupt-affinity = <&{/cpus/cpu@0}  &{/cpus/cpu@1}  &{/cpus/cpu@2}  &{/cpus/cpu@3} >;
		interrupts = <0x0 0x64 0x4 0x0 0x65 0x4 0x0 0x66 0x4 0x0 0x67 0x4>;
	};
	backlight {
		brightness-levels = <0x0 0x1 0x2 0x3 0x4 0x5 0x6 0x7 0x8 0x9 0xa 0xb 0xc 0xd 0xe 0xf 0x10 0x11 0x12 0x13 0x14 0x15 0x16 0x17 0x18 0x19 0x1a 0x1b 0x1c 0x1d 0x1e 0x1f 0x20 0x21 0x22 0x23 0x24 0x25 0x26 0x27 0x28 0x29 0x2a 0x2b 0x2c 0x2d 0x2e 0x2f 0x30 0x31 0x32 0x33 0x34 0x35 0x36 0x37 0x38 0x39 0x3a 0x3b 0x3c 0x3d 0x3e 0x3f 0x40 0x41 0x42 0x43 0x44 0x45 0x46 0x47 0x48 0x49 0x4a 0x4b 0x4c 0x4d 0x4e 0x4f 0x50 0x51 0x52 0x53 0x54 0x55 0x56 0x57 0x58 0x59 0x5a 0x5b 0x5c 0x5d 0x5e 0x5f 0x60 0x61 0x62 0x63 0x64 0x65 0x66 0x67 0x68 0x69 0x6a 0x6b 0x6c 0x6d 0x6e 0x6f 0x70 0x71 0x72 0x73 0x74 0x75 0x76 0x77 0x78 0x79 0x7a 0x7b 0x7c 0x7d 0x7e 0x7f 0x80 0x81 0x82 0x83 0x84 0x85 0x86 0x87 0x88 0x89 0x8a 0x8b 0x8c 0x8d 0x8e 0x8f 0x90 0x91 0x92 0x93 0x94 0x95 0x96 0x97 0x98 0x99 0x9a 0x9b 0x9c 0x9d 0x9e 0x9f 0xa0 0xa1 0xa2 0xa3 0xa4 0xa5 0xa6 0xa7 0xa8 0xa9 0xaa 0xab 0xac 0xad 0xae 0xaf 0xb0 0xb1 0xb2 0xb3 0xb4 0xb5 0xb6 0xb7 0xb8 0xb9 0xba 0xbb 0xbc 0xbd 0xbe 0xbf 0xc0 0xc1 0xc2 0xc3 0xc4 0xc5 0xc6 0xc7 0xc8 0xc9 0xca 0xcb 0xcc 0xcd 0xce 0xcf 0xd0 0xd1 0xd2 0xd3 0xd4 0xd5 0xd6 0xd7 0xd8 0xd9 0xda 0xdb 0xdc 0xdd 0xde 0xdf 0xe0 0xe1 0xe2 0xe3 0xe4 0xe5 0xe6 0xe7 0xe8 0xe9 0xea 0xeb 0xec 0xed 0xee 0xef 0xf0 0xf1 0xf2 0xf3 0xf4 0xf5 0xf6 0xf7 0xf8 0xf9 0xfa 0xfb 0xfc 0xfd 0xfe 0xff>;
		compatible = "pwm-backlight";
		default-brightness-level = <0xc8>;
		pwms = <&{/pwm@ff200010} 0x0 0x61a8 0x0>;
	};
	bus {
		#address-cells = <0x2>;
		#size-cells = <0x2>;
		compatible = "simple-bus";
		ranges;
		dmac@ff240000 {
			#dma-cells = <0x1>;
			arm,pl330-periph-burst;
			clock-names = "apb_pclk";
			clocks = <&{/clock-controller@ff2b0000} 0xbb>;
			compatible = "arm,pl330", "arm,primecell";
			interrupts = <0x0 0x1 0x4 0x0 0x2 0x4>;
			reg = <0x0 0xff240000 0x0 0x4000>;
		};
	};
	bus-apll {
		bus-supply = <&{/i2c@ff180000/pmic@20/regulators/DCDC_REG1} >;
		clock-names = "bus";
		clocks = <&{/clock-controller@ff2b0000} 0x1>;
		compatible = "rockchip,px30-bus";
		operating-points-v2 = <&{/bus-apll-opp-table} >;
		rockchip,busfreq-policy = "clkfreq";
		status = "okay";
	};
	bus-apll-opp-table {
		compatible = "operating-points-v2";
		opp-shared;
		opp-1008000000 {
			opp-hz = <0x0 0x3c14dc00>;
			opp-microvolt = <0xe7ef0>;
		};
		opp-1512000000 {
			opp-hz = <0x0 0x5a1f4a00>;
			opp-microvolt = <0xf4240>;
		};
	};
	bus-soc {
		compatible = "rockchip,px30-bus";
		rockchip,busfreq-policy = "autocs";
		soc-bus0 {
			bus-id = <0x0>;
			enable-msk = <0x40f7>;
			timer-us = <0x14>;
		};
		soc-bus1 {
			bus-id = <0x1>;
			enable-msk = <0x40bf>;
			status = "disabled";
			timer-us = <0xc8>;
		};
		soc-bus2 {
			bus-id = <0x2>;
			enable-msk = <0x4007>;
			status = "disabled";
			timer-us = <0xc8>;
		};
	};
	charge-animation {
		compatible = "rockchip,uboot-charge";
		rockchip,android-charge-on = <0x0>;
		rockchip,screen-on-voltage = <0xdac>;
		rockchip,uboot-charge-on = <0x1>;
		rockchip,uboot-exit-charge-auto = <0x1>;
		rockchip,uboot-exit-charge-voltage = <0xd7a>;
		rockchip,uboot-low-power-voltage = <0x0>;
		status = "okay";
	};
	cif-new@ff490000 {
		clock-names = "aclk_cif", "hclk_cif", "pclk_cif", "cif_out";
		clocks = <&{/clock-controller@ff2b0000} 0xb3 &{/clock-controller@ff2b0000} 0xf9 &{/clock-controller@ff2b0000} 0x160 &{/clock-controller@ff2b0000} 0x34>;
		compatible = "rockchip,px30-cif";
		interrupts = <0x0 0x45 0x4>;
		iommus = <&{/iommu@ff490800} >;
		power-domains = <&{/power-management@ff000000/power-controller} 0xd>;
		reg = <0x0 0xff490000 0x0 0x200>;
		reset-names = "rst_cif_a", "rst_cif_h", "rst_cif_pclkin";
		resets = <&{/clock-controller@ff2b0000} 0x2c &{/clock-controller@ff2b0000} 0x2d &{/clock-controller@ff2b0000} 0x2e>;
		status = "okay";
		port {
			endpoint {
				hsync-active = <0x1>;
				remote-endpoint = <&{/i2c@ff1a0000/gc2155@3c/port/endpoint} >;
				vsync-active = <0x0>;
			};
		};
	};
	cif@ff490000 {
		clock-names = "aclk_cif0", "hclk_cif0", "pclk_cif", "cif0_out";
		clocks = <&{/clock-controller@ff2b0000} 0xb3 &{/clock-controller@ff2b0000} 0xf9 &{/clock-controller@ff2b0000} 0x160 &{/clock-controller@ff2b0000} 0x34>;
		compatible = "rockchip,cif";
		interrupts = <0x0 0x45 0x4>;
		iommus = <&{/iommu@ff490800} >;
		pinctrl-0 = <&{/pinctrl/cif-m0/dvp-d2d9-m0} >;
		pinctrl-names = "cif_pin_all";
		power-domains = <&{/power-management@ff000000/power-controller} 0xd>;
		reg = <0x0 0xff490000 0x0 0x200>;
		reset-names = "rst_cif_a", "rst_cif_h", "rst_cif_pclkin";
		resets = <&{/clock-controller@ff2b0000} 0x2c &{/clock-controller@ff2b0000} 0x2d &{/clock-controller@ff2b0000} 0x2e>;
		status = "disabled";
	};
	clock-controller@ff2b0000 {
		#clock-cells = <0x1>;
		#reset-cells = <0x1>;
		assigned-clock-rates = <0x3dfd2400>;
		assigned-clocks = <&{/clock-controller@ff2b0000} 0x4>;
		compatible = "rockchip,px30-cru";
		reg = <0x0 0xff2b0000 0x0 0x1000>;
		rockchip,grf = <&{/syscon@ff140000} >;
	};
	clock-controller@ff2bc000 {
		#clock-cells = <0x1>;
		#reset-cells = <0x1>;
		assigned-clock-rates = <0x47868c00 0x5f5e100 0x18cba80 0x23c34600 0xbebc200 0xbebc200 0x8f0d180 0x8f0d180 0x5f5e100 0xbebc200>;
		assigned-clocks = <&{/clock-controller@ff2bc000} 0x1 &{/clock-controller@ff2bc000} 0x8 &{/clock-controller@ff2bc000} 0x5 &{/clock-controller@ff2b0000} 0x7 &{/clock-controller@ff2b0000} 0xab &{/clock-controller@ff2b0000} 0xb0 &{/clock-controller@ff2b0000} 0xf0 &{/clock-controller@ff2b0000} 0xf5 &{/clock-controller@ff2b0000} 0x140 &{/clock-controller@ff2b0000} 0x49>;
		compatible = "rockchip,px30-pmucru";
		reg = <0x0 0xff2bc000 0x0 0x1000>;
		rockchip,grf = <&{/syscon@ff140000} >;
	};
	cpu0-opp-table {
		clocks = <&{/clock-controller@ff2b0000} 0x1>;
		compatible = "operating-points-v2";
		nvmem-cell-names = "cpu_leakage", "performance";
		nvmem-cells = <&{/nvmem@ff290000/cpu-leakage@17}  &{/nvmem@ff290000/performance@1e} >;
		opp-shared;
		rockchip,avs = <0x1>;
		rockchip,avs-scale = <0x4>;
		rockchip,bin-scaling-sel = <0x0 0xd 0x1 0xf 0x2 0x12>;
		rockchip,evb-irdrop = <0x61a8>;
		rockchip,low-temp = <0x0>;
		rockchip,low-temp-adjust-volt = <0x0 0x5e8 0xc350>;
		rockchip,low-temp-min-volt = <0xf4240>;
		rockchip,max-volt = <0x149970>;
		rockchip,pvtm-ch = <0x0 0x0>;
		rockchip,pvtm-error = <0x3e8>;
		rockchip,pvtm-freq = <0x639c0>;
		rockchip,pvtm-number = <0xa>;
		rockchip,pvtm-ref-temp = <0x28>;
		rockchip,pvtm-sample-time = <0x3e8>;
		rockchip,pvtm-temp-prop = <0xffffffc8 0xffffffc8>;
		rockchip,pvtm-volt = <0xf4240>;
		rockchip,pvtm-voltage-sel = <0x0 0xc350 0x0 0xc351 0xd2f0 0x1 0xd2f1 0xea60 0x2 0xea61 0x1869f 0x3>;
		rockchip,temp-hysteresis = <0x1388>;
		rockchip,thermal-zone = "soc-thermal";
		opp-1008000000 {
			clock-latency-ns = <0x9c40>;
			opp-hz = <0x0 0x3c14dc00>;
			opp-microvolt = <0x11edd8 0x11edd8 0x149970>;
			opp-microvolt-L0 = <0x11edd8 0x11edd8 0x149970>;
			opp-microvolt-L1 = <0x112a88 0x112a88 0x149970>;
			opp-microvolt-L2 = <0x112a88 0x112a88 0x149970>;
			opp-microvolt-L3 = <0x100590 0x100590 0x149970>;
		};
		opp-1104000000 {
			clock-latency-ns = <0x9c40>;
			opp-hz = <0x0 0x41cdb400>;
			opp-microvolt = <0x13d620 0x13d620 0x149970>;
			opp-microvolt-L0 = <0x13d620 0x13d620 0x149970>;
			opp-microvolt-L1 = <0x137478 0x137478 0x149970>;
			opp-microvolt-L2 = <0x1312d0 0x1312d0 0x149970>;
			opp-microvolt-L3 = <0x124f80 0x124f80 0x149970>;
		};
		opp-1200000000 {
			clock-latency-ns = <0x9c40>;
			opp-hz = <0x0 0x47868c00>;
			opp-microvolt = <0x13d620 0x13d620 0x149970>;
			opp-microvolt-L0 = <0x13d620 0x13d620 0x149970>;
			opp-microvolt-L1 = <0x137478 0x137478 0x149970>;
			opp-microvolt-L2 = <0x1312d0 0x1312d0 0x149970>;
			opp-microvolt-L3 = <0x124f80 0x124f80 0x149970>;
		};
		opp-1248000000 {
			clock-latency-ns = <0x9c40>;
			opp-hz = <0x0 0x4a62f800>;
			opp-microvolt = <0x149970 0x149970 0x149970>;
			opp-microvolt-L0 = <0x149970 0x149970 0x149970>;
			opp-microvolt-L1 = <0x13d620 0x13d620 0x149970>;
			opp-microvolt-L2 = <0x137478 0x137478 0x149970>;
			opp-microvolt-L3 = <0x12b128 0x12b128 0x149970>;
		};
		opp-1296000000 {
			clock-latency-ns = <0x9c40>;
			opp-hz = "", "", "", "", "M?d";
			opp-microvolt = <0x149970 0x149970 0x149970>;
			opp-microvolt-L0 = <0x149970 0x149970 0x149970>;
			opp-microvolt-L1 = <0x149970 0x149970 0x149970>;
			opp-microvolt-L2 = <0x13d620 0x13d620 0x149970>;
			opp-microvolt-L3 = <0x1312d0 0x1312d0 0x149970>;
		};
		opp-1416000000 {
			clock-latency-ns = <0x9c40>;
			opp-hz = "", "", "", "", "Tfr";
			opp-microvolt = <0x149970 0x149970 0x149970>;
			opp-microvolt-L0 = <0x149970 0x149970 0x149970>;
			opp-microvolt-L1 = <0x149970 0x149970 0x149970>;
			opp-microvolt-L2 = <0x13d620 0x13d620 0x149970>;
			opp-microvolt-L3 = <0x1312d0 0x1312d0 0x149970>;
			status = "disabled";
		};
		opp-1512000000 {
			clock-latency-ns = <0x9c40>;
			opp-hz = <0x0 0x5a1f4a00>;
			opp-microvolt = <0x149970 0x149970 0x149970>;
			opp-microvolt-L0 = <0x149970 0x149970 0x149970>;
			opp-microvolt-L1 = <0x149970 0x149970 0x149970>;
			opp-microvolt-L2 = <0x13d620 0x13d620 0x149970>;
			opp-microvolt-L3 = <0x1312d0 0x1312d0 0x149970>;
			status = "disabled";
		};
		opp-408000000 {
			clock-latency-ns = <0x9c40>;
			opp-hz = <0x0 0x18519600>;
			opp-microvolt = <0xe7ef0 0xe7ef0 0x149970>;
			opp-microvolt-L0 = <0xe7ef0 0xe7ef0 0x149970>;
			opp-microvolt-L1 = <0xe7ef0 0xe7ef0 0x149970>;
			opp-microvolt-L2 = <0xe7ef0 0xe7ef0 0x149970>;
			opp-microvolt-L3 = <0xe7ef0 0xe7ef0 0x149970>;
			opp-suspend;
		};
		opp-600000000 {
			clock-latency-ns = <0x9c40>;
			opp-hz = <0x0 0x23c34600>;
			opp-microvolt = <0xe7ef0 0xe7ef0 0x149970>;
			opp-microvolt-L0 = <0xe7ef0 0xe7ef0 0x149970>;
			opp-microvolt-L1 = <0xe7ef0 0xe7ef0 0x149970>;
			opp-microvolt-L2 = <0xe7ef0 0xe7ef0 0x149970>;
			opp-microvolt-L3 = <0xe7ef0 0xe7ef0 0x149970>;
		};
		opp-816000000 {
			clock-latency-ns = <0x9c40>;
			opp-hz = <0x0 0x30a32c00>;
			opp-microvolt = <0x100590 0x100590 0x149970>;
			opp-microvolt-L0 = <0x100590 0x100590 0x149970>;
			opp-microvolt-L1 = <0xf4240 0xf4240 0x149970>;
			opp-microvolt-L2 = <0xf4240 0xf4240 0x149970>;
			opp-microvolt-L3 = <0xe7ef0 0xe7ef0 0x149970>;
		};
	};
	cpuinfo {
		compatible = "rockchip,cpuinfo";
		nvmem-cell-names = "id";
		nvmem-cells = <&{/nvmem@ff290000/id@7} >;
	};
	cpus {
		#address-cells = <0x2>;
		#size-cells = <0x0>;
		cpu@0 {
			#cooling-cells = <0x2>;
			clocks = <&{/clock-controller@ff2b0000} 0x7>;
			compatible = "arm,cortex-a35";
			cpu-idle-states = <&{/cpus/idle-states/cpu-sleep}  &{/cpus/idle-states/cluster-sleep} >;
			cpu-supply = <&{/i2c@ff180000/pmic@20/regulators/DCDC_REG2} >;
			device_type = "cpu";
			dynamic-power-coefficient = <0x5a>;
			enable-method = "psci";
			operating-points-v2 = <&{/cpu0-opp-table} >;
			reg = <0x0 0x0>;
		};
		cpu@1 {
			#cooling-cells = <0x2>;
			clocks = <&{/clock-controller@ff2b0000} 0x7>;
			compatible = "arm,cortex-a35";
			cpu-idle-states = <&{/cpus/idle-states/cpu-sleep}  &{/cpus/idle-states/cluster-sleep} >;
			device_type = "cpu";
			dynamic-power-coefficient = <0x5a>;
			enable-method = "psci";
			operating-points-v2 = <&{/cpu0-opp-table} >;
			reg = <0x0 0x1>;
		};
		cpu@2 {
			#cooling-cells = <0x2>;
			clocks = <&{/clock-controller@ff2b0000} 0x7>;
			compatible = "arm,cortex-a35";
			cpu-idle-states = <&{/cpus/idle-states/cpu-sleep}  &{/cpus/idle-states/cluster-sleep} >;
			device_type = "cpu";
			dynamic-power-coefficient = <0x5a>;
			enable-method = "psci";
			operating-points-v2 = <&{/cpu0-opp-table} >;
			reg = <0x0 0x2>;
		};
		cpu@3 {
			#cooling-cells = <0x2>;
			clocks = <&{/clock-controller@ff2b0000} 0x7>;
			compatible = "arm,cortex-a35";
			cpu-idle-states = <&{/cpus/idle-states/cpu-sleep}  &{/cpus/idle-states/cluster-sleep} >;
			device_type = "cpu";
			dynamic-power-coefficient = <0x5a>;
			enable-method = "psci";
			operating-points-v2 = <&{/cpu0-opp-table} >;
			reg = <0x0 0x3>;
		};
		idle-states {
			entry-method = "psci";
			cluster-sleep {
				arm,psci-suspend-param = <0x1010000>;
				compatible = "arm,idle-state";
				entry-latency-us = <0x190>;
				exit-latency-us = <0x1f4>;
				local-timer-stop;
				min-residency-us = <0x7d0>;
			};
			cpu-sleep {
				arm,psci-suspend-param = <0x10000>;
				compatible = "arm,idle-state";
				entry-latency-us = <0x78>;
				exit-latency-us = <0xfa>;
				local-timer-stop;
				min-residency-us = <0x384>;
			};
		};
	};
	crypto@ff0b0000 {
		clock-names = "aclk", "hclk", "sclk", "apb_pclk";
		clocks = <&{/clock-controller@ff2b0000} 0xac &{/clock-controller@ff2b0000} 0xf1 &{/clock-controller@ff2b0000} 0x30 &{/clock-controller@ff2b0000} 0x31>;
		compatible = "rockchip,px30-crypto";
		interrupts = <0x0 0x52 0x4>;
		reg = <0x0 0xff0b0000 0x0 0x400 0x0 0xff0b0480 0x0 0x3b80>;
		reset-names = "crypto-rst";
		resets = <&{/clock-controller@ff2b0000} 0x74>;
		status = "disabled";
	};
	ddr3-params {
		byte_map = <0xb1>;
		dq_map_cs0_dq_h = <0x0>;
		dq_map_cs0_dq_l = <0x0>;
		dq_map_cs1_dq_h = <0x0>;
		dq_map_cs1_dq_l = <0x0>;
		dram_dll_dis_freq = <0x12c>;
		dram_dq_drv_odten = <0x22>;
		dram_dq_drv_odtoff = <0x22>;
		dram_dq_odt_en_freq = <0x14d>;
		dram_ext_temp = <0x0>;
		dram_odt = <0x78>;
		expanded_version = <0x0>;
		freq_0 = <0x210>;
		freq_1 = <0x148>;
		freq_2 = <0x210>;
		freq_3 = <0x210>;
		freq_4 = <0x0>;
		freq_5 = <0x0>;
		mode_2t = <0x0>;
		pd_dis_freq = <0x42a>;
		pd_idle = <0xd>;
		phy_ca_drv_odten = <0x21>;
		phy_ca_drv_odtoff = <0x21>;
		phy_ca_sr_odten = <0x3>;
		phy_ca_sr_odtoff = <0x3>;
		phy_clk_drv_odten = <0x21>;
		phy_clk_drv_odtoff = <0x21>;
		phy_clk_sr_odten = <0x3>;
		phy_clk_sr_odtoff = <0x3>;
