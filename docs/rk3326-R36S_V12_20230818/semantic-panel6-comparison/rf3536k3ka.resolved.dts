	thermal-zones {
		gpu-thermal {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x64>;
			thermal-sensors = <&{/tsadc@ff280000} 0x1>;
		};
		soc-thermal {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x14>;
			sustainable-power = <0x2ee>;
			thermal-sensors = <&{/tsadc@ff280000} 0x0>;
			cooling-maps {
				map0 {
					contribution = <0x1000>;
					cooling-device = <&{/cpus/cpu@0} 0xffffffff 0xffffffff>;
					trip = <&{/thermal-zones/soc-thermal/trips/trip-point-1} >;
				};
				map1 {
					contribution = <0x1000>;
					cooling-device = <&{/gpu@ff400000} 0xffffffff 0xffffffff>;
					trip = <&{/thermal-zones/soc-thermal/trips/trip-point-1} >;
				};
			};
			trips {
				soc-crit {
					hysteresis = <0x7d0>;
					temperature = <0x1c138>;
					type = "critical";
				};
				trip-point-0 {
					hysteresis = <0x7d0>;
					temperature = <0x11170>;
					type = "passive";
				};
				trip-point-1 {
					hysteresis = <0x7d0>;
					temperature = <0x14c08>;
					type = "passive";
				};
			};
		};
	};
