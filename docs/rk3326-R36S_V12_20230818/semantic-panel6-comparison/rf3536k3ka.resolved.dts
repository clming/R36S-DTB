		interrupts = <0x0 0x3e 0x4>;
		phy-names = "usb2-phy";
		phys = <&{/syscon@ff2c0000/usb2-phy@100/otg-port} >;
		power-domains = <&{/power-management@ff000000/power-controller} 0x5>;
		reg = <0x0 0xff300000 0x0 0x40000>;
		status = "okay";
	};
	usb@ff340000 {
		clock-names = "usbhost", "utmi";
		clocks = <&{/clock-controller@ff2b0000} 0x103 &{/syscon@ff2c0000/usb2-phy@100} >;
		compatible = "generic-ehci";
		interrupts = <0x0 0x3c 0x4>;
		phy-names = "usb";
		phys = <&{/syscon@ff2c0000/usb2-phy@100/host-port} >;
		power-domains = <&{/power-management@ff000000/power-controller} 0x5>;
		reg = <0x0 0xff340000 0x0 0x10000>;
		status = "disabled";
	};
	usb@ff350000 {
		clock-names = "usbhost", "utmi";
		clocks = <&{/clock-controller@ff2b0000} 0x103 &{/syscon@ff2c0000/usb2-phy@100} >;
		compatible = "generic-ohci";
		interrupts = <0x0 0x3d 0x4>;
		phy-names = "usb";
		phys = <&{/syscon@ff2c0000/usb2-phy@100/host-port} >;
		power-domains = <&{/power-management@ff000000/power-controller} 0x5>;
		reg = <0x0 0xff350000 0x0 0x10000>;
		status = "disabled";
	};
	vcc18-lcd-n {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&{/pinctrl/gpio0@ff040000} 0xd 0x0>;
		regulator-boot-on;
		regulator-name = "vcc18_lcd_n";
		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};
	vccsys {
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-boot-on;
		regulator-max-microvolt = <0x4c4b40>;
		regulator-min-microvolt = <0x4c4b40>;
		regulator-name = "vcc5v0_sys";
	};
	vdpu@ff442400 {
		clock-names = "aclk_vcodec", "hclk_vcodec";
		clocks = <&{/clock-controller@ff2b0000} 0xaf &{/clock-controller@ff2b0000} 0xf4>;
		compatible = "rockchip,vpu-decoder-px30";
		interrupt-names = "irq_dec";
		interrupts = <0x0 0x4f 0x4>;
		iommus = <&{/iommu@ff442800} >;
		power-domains = <&{/power-management@ff000000/power-controller} 0xb>;
		reg = <0x0 0xff442400 0x0 0x400>;
		reset-names = "shared_video_a", "shared_video_h";
		resets = <&{/clock-controller@ff2b0000} 0x24 &{/clock-controller@ff2b0000} 0x26>;
		rockchip,resetgroup-node = <0x0>;
		rockchip,srv = <&{/mpp-srv} >;
		rockchip,taskqueue-node = <0x0>;
		status = "okay";
	};
	vepu@ff442000 {
		clock-names = "aclk_vcodec", "hclk_vcodec";
		clocks = <&{/clock-controller@ff2b0000} 0xaf &{/clock-controller@ff2b0000} 0xf4>;
		compatible = "rockchip,vpu-encoder-px30";
		interrupt-names = "irq_enc";
		interrupts = <0x0 0x50 0x4>;
		iommus = <&{/iommu@ff442800} >;
		power-domains = <&{/power-management@ff000000/power-controller} 0xb>;
		reg = <0x0 0xff442000 0x0 0x400>;
		reset-names = "shared_video_a", "shared_video_h";
		resets = <&{/clock-controller@ff2b0000} 0x24 &{/clock-controller@ff2b0000} 0x26>;
		rockchip,resetgroup-node = <0x0>;
		rockchip,srv = <&{/mpp-srv} >;
		rockchip,taskqueue-node = <0x0>;
		status = "okay";
	};
	vop@ff460000 {
		clock-names = "aclk_vop", "dclk_vop", "hclk_vop";
		clocks = <&{/clock-controller@ff2b0000} 0xb5 &{/clock-controller@ff2b0000} 0x96 &{/clock-controller@ff2b0000} 0xfb>;
		compatible = "rockchip,px30-vop-big";
		interrupts = <0x0 0x4d 0x4>;
		iommus = <&{/iommu@ff460f00} >;
		power-domains = <&{/power-management@ff000000/power-controller} 0xc>;
		reg = <0x0 0xff460000 0x0 0x1fc 0x0 0xff460a00 0x0 0x400>;
		reg-names = "regs", "gamma_lut";
		reset-names = "axi", "ahb", "dclk";
		resets = <&{/clock-controller@ff2b0000} 0x33 &{/clock-controller@ff2b0000} 0x34 &{/clock-controller@ff2b0000} 0x35>;
		rockchip,grf = <&{/syscon@ff140000} >;
		status = "okay";
		port {
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			endpoint@0 {
				reg = <0x0>;
				remote-endpoint = <&{/dsi@ff450000/ports/port@0/endpoint@0} >;
			};
			endpoint@1 {
				reg = <0x1>;
				remote-endpoint = <&{/syscon@ff140000/lvds/ports/port@0/endpoint@0} >;
			};
			endpoint@2 {
				reg = <0x2>;
				remote-endpoint = <&{/syscon@ff140000/rgb/ports/port@0/endpoint@0} >;
			};
		};
	};
	watchdog@ff1e0000 {
		clocks = <&{/clock-controller@ff2b0000} 0x15b>;
		compatible = "snps,dw-wdt";
		interrupts = <0x0 0x25 0x4>;
		reg = <0x0 0xff1e0000 0x0 0x100>;
		status = "disabled";
	};
	wireless-bluetooth {
		BT,wake_gpio = <&{/pinctrl/gpio0@ff040000} 0x1 0x0>;
		BT,wake_host_irq = <&{/pinctrl/gpio0@ff040000} 0x7 0x0>;
		clock-names = "ext_clock";
		compatible = "bluetooth-platdata";
		pinctrl-0 = <&{/pinctrl/uart1/uart1-rts} >;
		pinctrl-1 = <&{/pinctrl/uart1/uart1-rts-gpio} >;
		pinctrl-names = "default", "rts_gpio";
		status = "disabled";
		uart_rts_gpios = <&{/pinctrl/gpio1@ff250000} 0x13 0x1>;
	};
	xin24m {
		#clock-cells = <0x0>;
		clock-frequency = <0x16e3600>;
		clock-output-names = "xin24m";
		compatible = "fixed-clock";
	};
	xin32k {
		#clock-cells = <0x0>;
		clock-frequency = <0x8000>;
		clock-output-names = "xin32k";
		compatible = "fixed-clock";
	};
};
