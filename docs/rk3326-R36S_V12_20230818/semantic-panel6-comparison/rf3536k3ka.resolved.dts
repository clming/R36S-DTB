	dfi@ff610000 {
		compatible = "rockchip,px30-dfi";
		reg = <0x0 0xff610000 0x0 0x400>;
		rockchip,pmugrf = <&{/syscon@ff010000} >;
		status = "okay";
	};
	display-subsystem {
		compatible = "rockchip,display-subsystem";
		logo-memory-region = <&{/reserved-memory/drm-logo@00000000} >;
		ports = <&{/vop@ff460000/port} >;
		status = "okay";
		route {
			route-dsi {
				charge_logo,mode = "center";
				connect = <0x13>;
				logo,kernel = "logo_kernel.bmp";
				logo,mode = "center";
				logo,uboot = "logo.bmp";
				status = "okay";
			};
			route-lvds {
				charge_logo,mode = "center";
				connect = <0x12>;
				logo,kernel = "logo_kernel.bmp";
				logo,mode = "center";
				logo,uboot = "logo.bmp";
				status = "disabled";
			};
			route-rgb {
				charge_logo,mode = "center";
				connect = <0x14>;
				logo,kernel = "logo_kernel.bmp";
				logo,mode = "center";
				logo,uboot = "logo.bmp";
				status = "disabled";
			};
		};
	};
	dmc {
		#cooling-cells = <0x2>;
		auto-freq-en = <0x0>;
		auto-min-freq = <0x6ddd0>;
		center-supply = <&{/i2c@ff180000/pmic@20/regulators/DCDC_REG1} >;
		clock-names = "dmc_clk";
		clocks = <&{/clock-controller@ff2b0000} 0x54>;
		compatible = "rockchip,px30-dmc";
		ddr_timing = <&{/ddr_timing} >;
		devfreq-events = <&{/dfi@ff610000} >;
		downdifferential = <0x14>;
		interrupt-names = "complete_irq";
		interrupts = <0x0 0x69 0x4>;
		operating-points-v2 = <&{/dmc-opp-table} >;
		status = "okay";
		system-status-freq = <0x1 0x80e80 0x8 0x80e80 0x2 0x2f5d0 0x20 0x80e80 0x1000 0x80e80 0x4000 0x80e80 0x2000 0x80e80>;
		upthreshold = <0x28>;
		ddr_power_model {
			compatible = "ddr_power_model";
			dynamic-power-coefficient = <0x78>;
			static-power-coefficient = <0xc8>;
			thermal-zone = "soc-thermal";
			ts = <0x7d00 0x125c 0xffffffb0 0x2>;
		};
	};
	dmc-fsp {
		compatible = "rockchip,px30s-dmc-fsp";
		ddr3_params = <&{/ddr3-params} >;
		ddr4_params = <&{/ddr4-params} >;
		ddr_timing = <&{/ddr_timing} >;
		debug_print_level = <0x0>;
		lpddr2_params = <&{/lpddr2-params} >;
		lpddr3_params = <&{/lpddr3-params} >;
		lpddr4_params = <&{/lpddr4-params} >;
		phy_de_skew_en = <0x1>;
		status = "okay";
	};
	dmc-opp-table {
		compatible = "operating-points-v2";
		rockchip,evb-irdrop = <0x61a8>;
		rockchip,max-volt = <0x118c30>;
		rockchip,pvtm-ch = <0x0 0x0>;
		rockchip,pvtm-voltage-sel = <0x0 0xc350 0x0 0xc351 0xd2f0 0x1 0xd2f1 0xea60 0x2 0xea61 0x1869f 0x3>;
		opp-194000000 {
			opp-hz = <0x0 0xb903480>;
			opp-microvolt = <0xe7ef0>;
